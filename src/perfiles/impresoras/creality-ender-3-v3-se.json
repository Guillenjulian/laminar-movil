{
    "_nota": "Perfil de impresora. Las claves de 'dispositivo' y 'proceso' son las de Kiri:Moto; ver src/perfiles/LEEME.md. Las claves que empiezan con _ son comentarios y se ignoran.",
    "id": "creality-ender-3-v3-se",
    "nombre": "Creality Ender 3 V3 SE",
    "limites": {
        "_nota": "Máximos del fabricante. La app no deja pasar estas temperaturas.",
        "hotendMax": 260,
        "camaMax": 100
    },
    "dispositivo": {
        "deviceName": "Creality Ender 3 V3 SE",
        "bedWidth": 220,
        "bedDepth": 220,
        "maxHeight": 250,
        "_nota_origen": "originCenter false = el origen (0,0) es la esquina frontal izquierda de la cama.",
        "originCenter": false,
        "bedRound": false,
        "bedBelt": false,
        "fwRetract": false,
        "filamentSource": "direct",
        "gcodeFExt": "gcode",
        "extruders": [
            {
                "extNozzle": 0.4,
                "extFilament": 1.75,
                "extOffsetX": 0,
                "extOffsetY": 0
            }
        ],
        "gcodePre": [
            "; --- Inicio: Creality Ender 3 V3 SE (laminar-movil) ---",
            "M140 S{bed_temp}             ; calentar cama",
            "M104 S150                    ; precalentar boquilla sin que gotee",
            "M190 S{bed_temp}             ; esperar la cama",
            "G28                          ; home de todos los ejes (nivelación automática del equipo)",
            "M104 S{temp}                 ; temperatura de impresión",
            "M109 S{temp}                 ; esperar la boquilla",
            "G90                          ; coordenadas absolutas",
            "M83                          ; extrusor relativo",
            "G92 E0",
            "G1 Z2.0 F3000",
            "G1 X2 Y20 Z0.28 F5000        ; ir al borde izquierdo",
            "G1 X2 Y200 Z0.28 F1500 E15   ; línea de purga",
            "G1 X2.4 Y200 Z0.28 F5000",
            "G1 X2.4 Y20 Z0.28 F1500 E15  ; segunda línea de purga",
            "G92 E0",
            "G1 Z2.0 F3000"
        ],
        "gcodePost": [
            "; --- Fin ---",
            "G91                          ; coordenadas relativas",
            "G1 E-2 F2700                 ; retraer",
            "G1 E-2 Z0.2 F2400            ; retraer y subir",
            "G1 X5 Y5 F3000               ; alejarse de la pieza",
            "G1 Z10                       ; subir más",
            "G90",
            "G1 X0 Y{top} F3000           ; presentar la pieza",
            "M106 S0                      ; apagar ventilador",
            "M104 S0                      ; apagar boquilla",
            "M140 S0                      ; apagar cama",
            "M84 X Y E                    ; soltar motores (menos Z)"
        ],
        "_nota_ventilador": "Sin gcodeFan, Kiri no prende nunca el ventilador de capa.",
        "gcodeFan": ["M106 S{fan_speed}"],
        "gcodeTrack": ["M73 P{progress}"],
        "gcodeLayer": [";LAYER:{layer}"]
    },
    "proceso": {
        "_nota": "Valores base para cualquier calidad. Velocidades en mm/s, distancias en mm.",
        "outputRetractDist": 0.8,
        "outputRetractSpeed": 40,
        "outputRetractWipe": 0,
        "outputRetractDwell": 0,
        "zHopDistance": 0,
        "outputSeekrate": 150,
        "firstLayerRate": 30,
        "firstLayerFillRate": 30,
        "outputMaxFlowrate": 15,
        "outputBrimCount": 2,
        "outputBrimOffset": 3,
        "sliceFillType": "hex",
        "sliceSupportType": "disabled"
    },
    "calidades": {
