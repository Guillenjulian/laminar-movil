        "filamentSource": "direct",
        "gcodeFExt": "gcode",
        "extruders": [
            {
                "extNozzle": 0.4,
                "extFilament": 1.75,
                "extOffsetX": 0,
                "extOffsetY": 0
            }
        ],
        "gcodePre": [
            "; --- Inicio: Prusa MK4 (laminar-movil) ---",
            "M17                          ; encender motores",
            "M140 S{bed_temp}             ; calentar cama",
            "M104 S170                    ; precalentar boquilla sin que gotee",
            "M190 S{bed_temp}             ; esperar la cama",
            "G28                          ; home de todos los ejes",
            "M555 X0 Y0 W250 H210         ; área de la malla de nivelado: toda la cama",
            "G29                          ; malla de nivelado",
            "M104 S{temp}                 ; temperatura de impresión",
            "M109 S{temp}                 ; esperar la boquilla",
            "G90                          ; coordenadas absolutas",
            "M83                          ; extrusor relativo",
            "G92 E0",
            "G1 Z2.0 F3000",
            "G1 X10 Y5 Z0.2 F5000         ; ir al borde frontal",
            "G1 X240 Y5 Z0.2 F1500 E14    ; línea de purga",
            "G1 X240 Y5.5 Z0.2 F5000",
            "G1 X10 Y5.5 Z0.2 F1500 E14   ; segunda línea de purga",
            "G92 E0",
            "G1 Z2.0 F3000"
        ],
        "gcodePost": [
            "; --- Fin ---",
            "G91                          ; coordenadas relativas",
            "G1 E-2 F2700                 ; retraer",
            "G1 E-2 Z0.2 F2400            ; retraer y subir",
            "G1 X5 Y5 F3000               ; alejarse de la pieza",
            "G1 Z10                       ; subir más",
            "G90",
            "G1 X0 Y{top} F3000           ; presentar la pieza",
            "M106 S0                      ; apagar ventilador",
            "M104 S0                      ; apagar boquilla",
            "M140 S0                      ; apagar cama",
            "M84 X Y E                    ; soltar motores (menos Z)"
        ],
        "_nota_ventilador": "Sin gcodeFan, Kiri no prende nunca el ventilador de capa.",
        "gcodeFan": ["M106 S{fan_speed}"],
        "gcodeTrack": ["M73 P{progress}"],
        "gcodeLayer": [";LAYER:{layer}"]
    },
